# Template for local/beta/production `.env` files -- copy to `.env`, fill in real values, then
# run `npx dotenvx encrypt -f .env` (see docs/ENV_SECURITY.md for the full runbook). This file
# itself holds no secrets and is safe to commit.

# --- Database / cache -------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
REDIS_URL=

# --- App / auth --------------------------------------------------------------
SOVLEND_DOMAIN=
BETTER_AUTH_URL=
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Comma-separated emails granted super-admin on first sign-in.
SUPER_ADMIN_EMAILS=

# --- Price providers (all optional -- Frankfurter/exchangerate.fun are keyless
# and always enabled as a floor; these add extra sources/quota) --------------
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
CURRENCYFREAKS_API_KEY=
EXCHANGERATE_API_KEY=
FREECRYPTO_API_KEY=
FREECRYPTO_API_BASE_URL=

# --- Legacy iLend/Fineract migration source (read-only browsing; never used
# to submit) -------------------------------------------------------------
LEGACY_BASE_URL=
LEGACY_TENANT_ID=
LEGACY_USERNAME=
LEGACY_PASSWORD=
MIGRATION_ARCHIVE_DIR=.migration-data

# --- Blink (dev.blink.sv) -- Lightning payout/receive rail. BLINK_WALLET_ID must
# be the BTC wallet (not the USD/Stablesats one) -- confirm via
# `me { defaultAccount { wallets { id walletCurrency } } }`. BLINK_WEBHOOK_SECRET
# is the Svix signing secret (whsec_...) for this environment's registered
# callback endpoint (dashboard.blink.sv > Callback Endpoints). -----------------
BLINK_API_URL=https://api.blink.sv/graphql
BLINK_API_KEY=
BLINK_WALLET_ID=
BLINK_WEBHOOK_SECRET=

# --- SMS (Yoola) --------------------------------------------------------------
YOOLA_SMS_API_KEY=
YOOLA_SMS_SENDER_ID=

# --- Backups (restic) ---------------------------------------------------------
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

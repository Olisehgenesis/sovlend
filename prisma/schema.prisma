model Document {
  id                 String              @id @default(uuid()) @db.Uuid
  clientId           String?             @db.Uuid
  loanId             String?             @db.Uuid
  identifierId       String?             @db.Uuid
  familyMemberId     String?             @db.Uuid
  collateralId       String?             @db.Uuid

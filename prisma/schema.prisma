  @@unique([organizationId, name])
}

model LedgerAccount {
  id                          String                            @id @default(uuid()) @db.Uuid
  code                        String
  name                        String
  type                        AccountType
  currencyCode                String                            @db.VarChar(10)
  ownershipPoolId             String?                           @db.Uuid
  active                      Boolean                           @default(true)
  externalId                  String?
  usage                       String                            @default("DETAIL")
  description                 String?
  manualEntriesAllowed        Boolean                           @default(false)
  currency                    Currency                          @relation(fields: [currencyCode], references: [code])
  ownershipPool               OwnershipPool?                    @relation(fields: [ownershipPoolId], references: [id])
  lines                       JournalLine[]
  principalMappings           LoanProductAccountingMapping[]    @relation("PrincipalReceivable")
  interestReceivableMappings  LoanProductAccountingMapping[]    @relation("InterestReceivable")
  interestIncomeMappings      LoanProductAccountingMapping[]    @relation("InterestIncome")
  feeIncomeMappings           LoanProductAccountingMapping[]    @relation("FeeIncome")
  monitoringFeeIncomeMappings LoanProductAccountingMapping[]    @relation("MonitoringFeeIncome")
  processingFeeIncomeMappings LoanProductAccountingMapping[]    @relation("ProcessingFeeIncome")
  admissionFeeIncomeMappings  LoanProductAccountingMapping[]    @relation("AdmissionFeeIncome")
  penaltyIncomeMappings       LoanProductAccountingMapping[]    @relation("PenaltyIncome")
  penaltyReceivableMappings   LoanProductAccountingMapping[]    @relation("PenaltyReceivable")
  writeOffMappings            LoanProductAccountingMapping[]    @relation("WriteOffExpense")
  overpaymentMappings         LoanProductAccountingMapping[]    @relation("OverpaymentLiability")
  funds                       Fund[]
  settlementAccounts          SettlementAccount[]
  defaultPrincipalFor         LoanAccountingDefaults[]          @relation("DefaultPrincipalReceivable")
  defaultInterestFor          LoanAccountingDefaults[]          @relation("DefaultInterestIncome")
  defaultFeeFor               LoanAccountingDefaults[]          @relation("DefaultFeeIncome")
  defaultPenaltyFor           LoanAccountingDefaults[]          @relation("DefaultPenaltyIncome")
  defaultWriteOffFor          LoanAccountingDefaults[]          @relation("DefaultWriteOffExpense")
  defaultOverpaymentFor       LoanAccountingDefaults[]          @relation("DefaultOverpaymentLiability")
  savingsLiabilityMappings    SavingsProductAccountingMapping[] @relation("SavingsLiability")
  defaultSavingsLiabilityFor  SavingsAccountingDefaults[]       @relation("DefaultSavingsLiability")
  accountingRuleAccounts      AccountingRuleAccount[]
  defaultProvisionExpenseFor  ProvisioningAccountingDefaults[]  @relation("DefaultProvisionExpense")
  defaultLoanLossProvisionFor ProvisioningAccountingDefaults[]  @relation("DefaultLoanLossProvision")
  createdAt                   DateTime                          @default(now())

  @@unique([code, currencyCode, ownershipPoolId])
  @@index([type, currencyCode])
}

model LoanProductAccountingMapping {
  id                            String         @id @default(uuid()) @db.Uuid
  productId                     String         @unique @db.Uuid
  principalReceivableAccountId  String         @db.Uuid
  interestReceivableAccountId   String?        @db.Uuid
  interestIncomeAccountId       String         @db.Uuid
  feeIncomeAccountId            String?        @db.Uuid
  // Dedicated income accounts so monitoring fee, one-off processing fee, and inception admission
  // fee are never combined with each other, with interest, or with the generic feeIncomeAccountId
  // -- even when their configured rates coincide (e.g. a 2.5% monitoring fee alongside 2.5%
  // interest). Each falls back to feeIncomeAccountId when unset, preserving today's behavior for
  // organizations that haven't configured the dedicated accounts yet.
  monitoringFeeIncomeAccountId  String?        @db.Uuid
  processingFeeIncomeAccountId  String?        @db.Uuid
  admissionFeeIncomeAccountId   String?        @db.Uuid
  penaltyIncomeAccountId        String?        @db.Uuid
  // Accrual-side receivable debited when assess-loan-penalties.ts posts a penalty before it is
  // collected. Required (alongside penaltyIncomeAccountId) for the assessment job to post for
  // this product; see LoanInstallment.penaltyAssessedOn for how collection later avoids
  // double-recognizing that same income at repayment time.
  penaltyReceivableAccountId    String?        @db.Uuid
  writeOffExpenseAccountId      String?        @db.Uuid
  overpaymentLiabilityAccountId String?        @db.Uuid
  product                       LoanProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  principalReceivableAccount    LedgerAccount  @relation("PrincipalReceivable", fields: [principalReceivableAccountId], references: [id])
  interestReceivableAccount     LedgerAccount? @relation("InterestReceivable", fields: [interestReceivableAccountId], references: [id])
  interestIncomeAccount         LedgerAccount  @relation("InterestIncome", fields: [interestIncomeAccountId], references: [id])
  feeIncomeAccount              LedgerAccount? @relation("FeeIncome", fields: [feeIncomeAccountId], references: [id])
  monitoringFeeIncomeAccount    LedgerAccount? @relation("MonitoringFeeIncome", fields: [monitoringFeeIncomeAccountId], references: [id])
  processingFeeIncomeAccount    LedgerAccount? @relation("ProcessingFeeIncome", fields: [processingFeeIncomeAccountId], references: [id])
  admissionFeeIncomeAccount     LedgerAccount? @relation("AdmissionFeeIncome", fields: [admissionFeeIncomeAccountId], references: [id])
  penaltyIncomeAccount          LedgerAccount? @relation("PenaltyIncome", fields: [penaltyIncomeAccountId], references: [id])
  penaltyReceivableAccount      LedgerAccount? @relation("PenaltyReceivable", fields: [penaltyReceivableAccountId], references: [id])
  writeOffExpenseAccount        LedgerAccount? @relation("WriteOffExpense", fields: [writeOffExpenseAccountId], references: [id])
  overpaymentLiabilityAccount   LedgerAccount? @relation("OverpaymentLiability", fields: [overpaymentLiabilityAccountId], references: [id])
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
}

// Organization-wide fallback accounts used to pre-fill new loan product mappings.
model LoanAccountingDefaults {
  id                            String         @id @default(uuid()) @db.Uuid
  organizationId                String         @unique @db.Uuid
  principalReceivableAccountId  String?        @db.Uuid
  interestIncomeAccountId       String?        @db.Uuid
  feeIncomeAccountId            String?        @db.Uuid
  penaltyIncomeAccountId        String?        @db.Uuid
  writeOffExpenseAccountId      String?        @db.Uuid
  overpaymentLiabilityAccountId String?        @db.Uuid
  organization                  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  principalReceivableAccount    LedgerAccount? @relation("DefaultPrincipalReceivable", fields: [principalReceivableAccountId], references: [id])
  interestIncomeAccount         LedgerAccount? @relation("DefaultInterestIncome", fields: [interestIncomeAccountId], references: [id])
  feeIncomeAccount              LedgerAccount? @relation("DefaultFeeIncome", fields: [feeIncomeAccountId], references: [id])
  penaltyIncomeAccount          LedgerAccount? @relation("DefaultPenaltyIncome", fields: [penaltyIncomeAccountId], references: [id])
  writeOffExpenseAccount        LedgerAccount? @relation("DefaultWriteOffExpense", fields: [writeOffExpenseAccountId], references: [id])
  overpaymentLiabilityAccount   LedgerAccount? @relation("DefaultOverpaymentLiability", fields: [overpaymentLiabilityAccountId], references: [id])
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
}

// Per-product override for the liability account credited/debited by a savings deposit/
// withdrawal (see post-savings-transaction.ts). Mirrors LoanProductAccountingMapping's role for
// loans. Falls back to SavingsAccountingDefaults, then to the legacy hardcoded chart-of-accounts
// lookup in savings-ledger.ts, so unconfigured organizations keep today's behavior.
model SavingsProductAccountingMapping {
  id                        String         @id @default(uuid()) @db.Uuid
  productId                 String         @unique @db.Uuid
  savingsLiabilityAccountId String         @db.Uuid
  product                   SavingsProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  savingsLiabilityAccount   LedgerAccount  @relation("SavingsLiability", fields: [savingsLiabilityAccountId], references: [id])
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

// Organization-wide fallback "Client Savings Liability" account, credited on deposit and debited
// on withdrawal when a savings product has no dedicated SavingsProductAccountingMapping. Mirrors
// LoanAccountingDefaults's role for loans. Configurable via the backoffice accounting settings
// page rather than hardcoded, per the accounting audit's requirement.
model SavingsAccountingDefaults {
  id                        String         @id @default(uuid()) @db.Uuid
  organizationId            String         @unique @db.Uuid
  savingsLiabilityAccountId String?        @db.Uuid
  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savingsLiabilityAccount   LedgerAccount? @relation("DefaultSavingsLiability", fields: [savingsLiabilityAccountId], references: [id])
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

model SettlementAccount {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  name                String
  type                String
  provider            String?
  accountReference    String?
  currencyCode        String               @db.VarChar(10)
  ledgerAccountId     String               @db.Uuid
  active              Boolean              @default(true)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerAccount       LedgerAccount        @relation(fields: [ledgerAccountId], references: [id])
  loanTransactions    LoanTransaction[]
  savingsTransactions SavingsTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([organizationId, name, currencyCode])
  @@index([organizationId, type, active])
  @@index([ledgerAccountId])
  @@map("SettlementAccountMapping")
}

model Journal {
  id                  String               @id @default(uuid()) @db.Uuid
  officeId            String               @db.Uuid
  businessDate        DateTime             @db.Date
  referenceType       String
  referenceId         String?
  narration           String
  status              JournalStatus        @default(PENDING)
  reversalOfId        String?              @unique @db.Uuid
  idempotencyKey      String               @unique
  office              Office               @relation(fields: [officeId], references: [id])
  lines               JournalLine[]
  reversalOf          Journal?             @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy          Journal?             @relation("JournalReversal")
  provisioningPosting ProvisioningPosting?
  postedAt            DateTime?
  createdAt           DateTime             @default(now())

  @@index([officeId, businessDate, status])
  @@index([referenceType, referenceId])
}

model JournalLine {
  id          String         @id @default(uuid()) @db.Uuid
  journalId   String         @db.Uuid
  accountId   String         @db.Uuid
  direction   EntryDirection
  amountMinor BigInt
  memo        String?
  journal     Journal        @relation(fields: [journalId], references: [id])
  account     LedgerAccount  @relation(fields: [accountId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([journalId])
  @@index([accountId, createdAt])
}

// A predefined debit/credit account template a user can pick by name when posting a "Frequent
// posting" (see post-accounting-rule-transaction.ts) instead of choosing raw accounts every time
// -- e.g. "Petty Cash Replenishment: Dr Office Supplies Expense, Cr Cash". Each side (DEBIT/
// CREDIT) can list one fixed account or several allowed accounts the poster picks from at
// posting time (mirrors iLend's "Debit/Credit Tags" accounting rules).
model AccountingRule {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  // Null means the rule is usable from any office in the organization.
  officeId       String?                 @db.Uuid
  name           String
  description    String?
  active         Boolean                 @default(true)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office         Office?                 @relation(fields: [officeId], references: [id])
  accounts       AccountingRuleAccount[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model AccountingRuleAccount {
  id        String         @id @default(uuid()) @db.Uuid
  ruleId    String         @db.Uuid
  accountId String         @db.Uuid
  side      EntryDirection
  rule      AccountingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  account   LedgerAccount  @relation(fields: [accountId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([ruleId, accountId, side])
  @@index([ruleId, side])
}

// Period-end lock: once created, journals with a businessDate on/before the latest closure's
// closingDate for an office are rejected by assertPeriodOpen() (see
// src/modules/ledger/application/assert-period-open.ts). Purely additive and opt-in -- existing
// posting behavior is completely unchanged for any office that has never had a closure created.
// closingDate is expected to move forward only (enforced in manage-accounting-closures.ts), so
// the latest row for an office is always the one with the greatest closingDate.
model AccountingClosure {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  officeId        String       @db.Uuid
  closingDate     DateTime     @db.Date
  comment         String?
  createdByUserId String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office          Office       @relation(fields: [officeId], references: [id])
  createdByUser   User         @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([officeId, closingDate])
}

// Organization-wide fallback accounts for posting provisioning entries (item 6, "Provisioning
// Entries" in iLend's Accounting menu) -- mirrors LoanAccountingDefaults/SavingsAccountingDefaults'
// role exactly. Both nullable/opt-in: postProvisioningEntry() requires both to be configured
// before it will post for an organization, so this is a pure addition with no effect until an
// admin sets it up via the Accounting mappings page.
model ProvisioningAccountingDefaults {
  id                         String         @id @default(uuid()) @db.Uuid
  organizationId             String         @unique @db.Uuid
  // Expense account debited for the period's required loan-loss provision (P&L impact).
  provisionExpenseAccountId  String?        @db.Uuid
  // Contra-asset/liability account credited to build up the provision balance against the loan
  // portfolio (iLend/Mifos "Provision for Loan Losses" / "Loan Loss Reserve").
  loanLossProvisionAccountId String?        @db.Uuid
  organization               Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provisionExpenseAccount    LedgerAccount? @relation("DefaultProvisionExpense", fields: [provisionExpenseAccountId], references: [id])
  loanLossProvisionAccount   LedgerAccount? @relation("DefaultLoanLossProvision", fields: [loanLossProvisionAccountId], references: [id])
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
}

// One row per office+asOfDate a provisioning entry was posted (or evaluated with a zero delta).
// Used to (a) make postProvisioningEntry() idempotent per office+date, and (b) compute the next
// run's delta against the last posted requiredProvisionMinor, so postings only ever move the
// provision balance forward or back by the change in required coverage since the prior run --
// never re-post the full requirement and double the ledger balance. journalId is null on a
// zero-delta evaluation (nothing was posted).
model ProvisioningPosting {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @db.Uuid
  officeId               String       @db.Uuid
  asOfDate               DateTime     @db.Date
  requiredProvisionMinor BigInt
  previousProvisionMinor BigInt
  deltaMinor             BigInt
  journalId              String?      @unique @db.Uuid
  createdByUserId        String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                 Office       @relation(fields: [officeId], references: [id])
  journal                Journal?     @relation(fields: [journalId], references: [id])
  createdByUser          User         @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime     @default(now())

  @@unique([officeId, asOfDate])
  @@index([officeId, asOfDate])
}

model PriceSnapshot {
  id               String                 @id @default(uuid()) @db.Uuid
  baseCode         String                 @db.VarChar(10)
  quoteCode        String                 @db.VarChar(10)
  price            Decimal                @db.Decimal(38, 18)
  status           PriceStatus
  observedAt       DateTime
  expiresAt        DateTime
  sourceQuotes     Json
  createdAt        DateTime               @default(now())
  base             Currency               @relation("PriceBase", fields: [baseCode], references: [code])
  quote            Currency               @relation("PriceQuote", fields: [quoteCode], references: [code])
  loanTransactions LoanTransaction[]
  investments      InvestmentCommitment[]

  @@index([baseCode, quoteCode, observedAt(sort: Desc)])
}

model InvestorProfile {
  id            String                       @id @default(uuid()) @db.Uuid
  userId        String                       @unique
  displayName   String

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GENERAL_MANAGER
  BRANCH_MANAGER
  TELLER
  LOAN_OFFICER
  CLIENT
  INVESTOR
  TREASURY_SIGNER
  AUDITOR
  // Non-interactive service identity used by automated jobs (e.g. the standing-order sweep).
  // Always `banned = true` so it can never sign in; only ever referenced by id from job code.
  SYSTEM
}

enum ClientStatus {
  DRAFT
  SUBMITTED
  ACTIVE
  INACTIVE
  CLOSED
  REJECTED
  BLOCKED
}

enum KycStatus {
  INCOMPLETE
  SUBMITTED
  VERIFIED
  REJECTED
}

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  DISBURSED
}

enum LoanStatus {
  APPROVED
  ACTIVE
  IN_ARREARS
  OVERPAID
  WRITTEN_OFF
  CLOSED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum JournalStatus {
  PENDING
  POSTED
  REVERSED
}

enum OwnershipType {
  INVESTOR_CAPITAL
  CLIENT_SAVINGS
  COMPANY_TREASURY
  OPERATING_FUNDS
}

enum WalletKind {
  HOT
  COLD_MULTISIG
  DEPOSIT
}

enum WalletNetwork {
  BITCOIN
  EVM
}

enum ProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  BROADCAST
  CONFIRMED
  REJECTED
  FAILED
}

enum PriceStatus {
  QUORUM
  DEGRADED
  MANUAL
}

enum ReminderType {
  REPAYMENT_DUE_SOON
  REPAYMENT_DUE_TODAY
  REPAYMENT_OVERDUE
  STANDING_ORDER_SWEPT
}

enum ReminderStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum PermissionScope {
  ORGANIZATION
  OFFICE
  OWN
}

enum InvestorAccessStatus {
  REQUESTED
  INVITED
  ACTIVE
  REJECTED
  SUSPENDED
}

enum InvestmentStatus {
  DRAFT
  AWAITING_INVOICE
  AWAITING_PAYMENT
  SETTLEMENT_PENDING
  FUNDED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum LightningInvoiceStatus {
  NEW
  PAID
  EXPIRED
  CANCELLED
}

enum MigrationRunStatus {
  CREATED
  EXTRACTING
  EXTRACTED
  IMPORTING
  RECONCILING
  COMPLETED
  FAILED
}

model Organization {
  id                             String                          @id @default(uuid()) @db.Uuid
  name                           String
  baseCurrency                   String                          @default("UGX")
  nextClientSequence             Int                             @default(1)
  nextGroupSequence              Int                             @default(1)
  offices                        Office[]
  users                          User[]
  clients                        Client[]
  loanProducts                   LoanProduct[]
  savingsProducts                SavingsProduct[]
  chargeDefinitions              ChargeDefinition[]
  ownershipPools                 OwnershipPool[]
  permissionGroups               PermissionGroup[]
  investorAccesses               InvestorOrganizationAccess[]
  investorInvites                InvestorInvite[]
  investorRequests               InvestorAccessRequest[]
  investments                    InvestmentCommitment[]
  funds                          Fund[]
  settlementAccounts             SettlementAccount[]
  accountingDefaults             LoanAccountingDefaults?
  savingsAccountingDefaults      SavingsAccountingDefaults?
  groups                         Group[]
  loanExportJobs                 LoanExportJob[]
  accountingRules                AccountingRule[]
  accountingClosures             AccountingClosure[]
  provisioningAccountingDefaults ProvisioningAccountingDefaults?
  provisioningPostings           ProvisioningPosting[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
}

model Office {
  id                    String                     @id @default(uuid()) @db.Uuid
  organizationId        String                     @db.Uuid
  parentId              String?                    @db.Uuid
  name                  String
  externalId            String?
  organization          Organization               @relation(fields: [organizationId], references: [id])
  parent                Office?                    @relation("OfficeHierarchy", fields: [parentId], references: [id])
  children              Office[]                   @relation("OfficeHierarchy")
  users                 User[]
  clients               Client[]
  loans                 Loan[]
  loanApplications      LoanApplication[]
  journals              Journal[]
  permissionAssignments UserPermissionAssignment[]
  groups                Group[]
  accountingRules       AccountingRule[]
  accountingClosures    AccountingClosure[]
  provisioningPostings  ProvisioningPosting[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, parentId])
}

model User {
  id                          String                     @id
  name                        String
  email                       String                     @unique
  emailVerified               Boolean                    @default(false)
  image                       String?
  role                        String?
  banned                      Boolean?                   @default(false)
  banReason                   String?
  banExpires                  DateTime?
  organizationId              String?                    @db.Uuid
  officeId                    String?                    @db.Uuid
  systemRole                  UserRole                   @default(CLIENT)
  mustChangePassword          Boolean                    @default(false)
  organization                Organization?              @relation(fields: [organizationId], references: [id])
  office                      Office?                    @relation(fields: [officeId], references: [id])
  sessions                    Session[]
  accounts                    Account[]
  passkeys                    Passkey[]
  clientProfile               Client?                    @relation("ClientAuthUser")
  assignedClients             Client[]                   @relation("AssignedOfficer")
  assignedLoans               Loan[]                     @relation("AssignedLoanOfficer")
  approvals                   Approval[]
  auditEvents                 AuditEvent[]
  permissionAssignments       UserPermissionAssignment[]
  submittedApplications       LoanApplication[]          @relation("ApplicationSubmitter")
  investorProfile             InvestorProfile?
  clientNotes                 ClientNote[]
  loanNotes                   LoanNote[]
  assignedGroups              Group[]                    @relation("AssignedGroupOfficer")
  groupNotes                  GroupNote[]
  assignedSavingsAccounts     SavingsAccount[]           @relation("AssignedSavingsOfficer")
  submittedSavingsAccounts    SavingsAccount[]           @relation("SavingsAccountSubmittedBy")
  approvedSavingsAccounts     SavingsAccount[]           @relation("SavingsAccountApprovedBy")
  recordedSavingsTransactions SavingsTransaction[]       @relation("RecordedSavingsTransactions")
  loanServiceRequestsMade     LoanServiceRequest[]       @relation("LoanServiceRequestRequestedBy")
  loanServiceRequestsDecided  LoanServiceRequest[]       @relation("LoanServiceRequestDecidedBy")
  loanExportJobsRequested     LoanExportJob[]
  recordedLoanTransactions    LoanTransaction[]          @relation("RecordedLoanTransactions")
  loanOfficerApplications     LoanApplication[]          @relation("ApplicationLoanOfficer")
  applicationDocuments        LoanApplicationDocument[]
  applicationNotes            LoanApplicationNote[]
  accountingClosures          AccountingClosure[]
  provisioningPostings        ProvisioningPosting[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@index([organizationId, officeId, systemRole])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Currency {
  code        String          @id @db.VarChar(10)
  name        String
  exponent    Int
  active      Boolean         @default(true)
  accounts    LedgerAccount[]
  pricesBase  PriceSnapshot[] @relation("PriceBase")
  pricesQuote PriceSnapshot[] @relation("PriceQuote")
  createdAt   DateTime        @default(now())
}

model Client {
  id                  String               @id @default(uuid()) @db.Uuid
  authUserId          String?              @unique
  organizationId      String               @db.Uuid
  officeId            String               @db.Uuid
  assignedOfficerId   String?
  accountNumber       String
  externalId          String?
  photoDocumentId     String?              @unique @db.Uuid
  signatureDocumentId String?              @unique @db.Uuid
  firstName           String
  middleName          String?
  lastName            String
  mobileNumber        String?
  dateOfBirth         DateTime?            @db.Date
  genderCode          String?
  clientTypeCode      String?
  classificationCode  String?
  isStaff             Boolean              @default(false)
  status              ClientStatus         @default(DRAFT)
  kycStatus           KycStatus            @default(INCOMPLETE)
  submittedOn         DateTime?            @db.Date
  activatedOn         DateTime?            @db.Date
  organization        Organization         @relation(fields: [organizationId], references: [id])
  office              Office               @relation(fields: [officeId], references: [id])
  assignedOfficer     User?                @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  authUser            User?                @relation("ClientAuthUser", fields: [authUserId], references: [id])
  photoDocument       Document?            @relation("ClientPhoto", fields: [photoDocumentId], references: [id], onDelete: SetNull)
  signatureDocument   Document?            @relation("ClientSignature", fields: [signatureDocumentId], references: [id], onDelete: SetNull)
  applications        LoanApplication[]
  loans               Loan[]
  savingsAccounts     SavingsAccount[]
  documents           Document[]
  familyMembers       ClientFamilyMember[]
  identifiers         ClientIdentifier[]
  notes               ClientNote[]
  charges             Charge[]
  groupMemberships    GroupMember[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([organizationId, accountNumber])
  @@index([organizationId, officeId, status])
  @@index([organizationId, externalId])
}

model ClientFamilyMember {
  id            String     @id @default(uuid()) @db.Uuid
  clientId      String     @db.Uuid
  firstName     String
  middleName    String?
  lastName      String
  qualification String?
  mobileNumber  String?
  age           Int?
  isDependent   Boolean    @default(false)
  relationship  String?
  genderCode    String?
  profession    String?
  maritalStatus String?
  dateOfBirth   DateTime?  @db.Date
  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents     Document[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([clientId])
}

model ClientIdentifier {
  id           String     @id @default(uuid()) @db.Uuid
  clientId     String     @db.Uuid
  documentType String
  status       String     @default("ACTIVE")
  uniqueNumber String
  description  String?
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents    Document[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([clientId, documentType, uniqueNumber])
  @@index([clientId])
}

model ClientNote {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  authorId  String
  body      String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Charge {
  id                 String            @id @default(uuid()) @db.Uuid
  clientId           String?           @db.Uuid
  groupId            String?           @db.Uuid
  loanId             String?           @db.Uuid
  chargeDefinitionId String?           @db.Uuid
  savingsAccountId   String?           @db.Uuid
  name               String
  amountMinor        BigInt
  currencyCode       String            @default("UGX")
  status             String            @default("PENDING")
  dueOn              DateTime?         @db.Date
  client             Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group              Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  loan               Loan?             @relation(fields: [loanId], references: [id], onDelete: SetNull)
  chargeDefinition   ChargeDefinition? @relation(fields: [chargeDefinitionId], references: [id], onDelete: SetNull)
  savingsAccount     SavingsAccount?   @relation(fields: [savingsAccountId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([clientId, status])
  @@index([groupId, status])
  @@index([loanId, status])
  @@index([loanId, dueOn])
  @@index([chargeDefinitionId])
  @@index([savingsAccountId])
}

enum GroupStatus {
  PENDING
  ACTIVE
  CLOSED
}

model Group {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  officeId         String            @db.Uuid
  staffId          String?
  accountNumber    String
  externalId       String?
  name             String
  status           GroupStatus       @default(PENDING)
  submittedOn      DateTime?         @db.Date
  activatedOn      DateTime?         @db.Date
  organization     Organization      @relation(fields: [organizationId], references: [id])
  office           Office            @relation(fields: [officeId], references: [id])
  assignedOfficer  User?             @relation("AssignedGroupOfficer", fields: [staffId], references: [id])
  members          GroupMember[]
  notes            GroupNote[]
  loanApplications LoanApplication[]
  loans            Loan[]
  savingsAccounts  SavingsAccount[]
  charges          Charge[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, accountNumber])
  @@index([organizationId, officeId, status])
}

model GroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  clientId  String   @db.Uuid
  joinedOn  DateTime @default(now()) @db.Date
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, clientId])
  @@index([clientId])
}

model GroupNote {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  authorId  String
  body      String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([groupId])
}

model LoanNote {
  id           String          @id @default(uuid()) @db.Uuid
  loanId       String          @db.Uuid
  collateralId String?         @db.Uuid
  authorId     String
  body         String
  loan         Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  collateral   LoanCollateral? @relation(fields: [collateralId], references: [id], onDelete: SetNull)
  author       User            @relation(fields: [authorId], references: [id])
  createdAt    DateTime        @default(now())

  @@index([loanId])
  @@index([collateralId])
}

model LoanProduct {
  id                         String                        @id @default(uuid()) @db.Uuid
  organizationId             String                        @db.Uuid
  name                       String
  shortName                  String
  denominationCurrency       String                        @default("UGX")
  principalMinMinor          BigInt
  principalMaxMinor          BigInt
  annualRateBps              Int
  monitoringFeeAnnualRateBps Int                           @default(0)
  repaymentCount             Int
  repaymentFrequency         String
  amortizationMethod         String
  interestMethod             String
  // Forward-looking penalty accrual rule, assessed by assess-loan-penalties.ts (see
  // src/modules/lending/domain/penalty-assessment.ts for the authoritative shape/parser):
  // { graceDays: number, calculationType: "FLAT" | "PERCENT_OF_OVERDUE", amountMinor?: string,
  //   percentageBps?: number }. Null/absent disables assessment for this product. Historical
  // installments imported before this feature shipped are never retroactively assessed -- see
  // penalty-assessment.ts's bounded assessment window for why that is structurally impossible.
  lateFeeRule                Json?
  version                    Int                           @default(1)
  active                     Boolean                       @default(true)
  organization               Organization                  @relation(fields: [organizationId], references: [id])
  applications               LoanApplication[]
  loans                      Loan[]
  accountingMapping          LoanProductAccountingMapping?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  @@unique([organizationId, shortName, version])
  @@index([organizationId, active])
}

model SavingsProduct {
  id                     String                           @id @default(uuid()) @db.Uuid
  organizationId         String                           @db.Uuid
  name                   String
  shortName              String
  description            String?
  currencyCode           String                           @default("UGX")
  nominalAnnualRateBps   Int                              @default(0)
  minOpeningBalanceMinor BigInt                           @default(0)
  active                 Boolean                          @default(true)
  organization           Organization                     @relation(fields: [organizationId], references: [id])
  savingsAccounts        SavingsAccount[]
  accountingMapping      SavingsProductAccountingMapping?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  @@unique([organizationId, shortName])
  @@index([organizationId, active])
}

model ChargeDefinition {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  name            String
  appliesTo       String
  calculationType String
  amountMinor     BigInt?
  percentageBps   Int?
  currencyCode    String       @default("UGX")
  penalty         Boolean      @default(false)
  active          Boolean      @default(true)
  organization    Organization @relation(fields: [organizationId], references: [id])
  charges         Charge[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Fund {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  name             String
  code             String?
  ledgerAccountId  String?           @db.Uuid
  isActive         Boolean           @default(true)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerAccount    LedgerAccount?    @relation(fields: [ledgerAccountId], references: [id])
  loanApplications LoanApplication[]
  loans            Loan[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([ledgerAccountId])
}

model LoanApplication {
  id                     String                    @id @default(uuid()) @db.Uuid
  submittedById          String?
  clientId               String?                   @db.Uuid
  groupId                String?                   @db.Uuid
  officeId               String                    @db.Uuid
  productId              String                    @db.Uuid
  loanOfficerId          String?
  fundId                 String?                   @db.Uuid
  proposedPrincipalMinor BigInt
  approvedPrincipalMinor BigInt?
  status                 LoanApplicationStatus     @default(DRAFT)
  purpose                String?
  externalId             String?
  applicationExpiresOn   DateTime?                 @db.Date
  // Wizard-captured overrides of the product defaults (term, interest rate, amortization, etc.),
  // mirroring Loan.termsSnapshot's pattern so approval can carry the applicant's chosen terms
  // forward onto the created loan instead of silently re-reading product defaults.
  termsSnapshot          Json?
  // Charges the applicant selected on the Charges step (each references a ChargeDefinition id,
  // name, and amount at time of application) — copied onto the loan's Charge rows on approval.
  chargesSnapshot        Json?
  // Collateral items captured on the Charges step (type/value/description) — copied onto
  // LoanCollateral rows on approval.
  collateralSnapshot     Json?
  submittedAt            DateTime?
  approvedAt             DateTime?
  client                 Client?                   @relation(fields: [clientId], references: [id])
  group                  Group?                    @relation(fields: [groupId], references: [id])
  office                 Office                    @relation(fields: [officeId], references: [id])
  product                LoanProduct               @relation(fields: [productId], references: [id])
  fund                   Fund?                     @relation(fields: [fundId], references: [id])
  loanOfficer            User?                     @relation("ApplicationLoanOfficer", fields: [loanOfficerId], references: [id])
  submittedBy            User?                     @relation("ApplicationSubmitter", fields: [submittedById], references: [id])
  approvals              Approval[]
  loan                   Loan?
  documents              LoanApplicationDocument[]
  notes                  LoanApplicationNote[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([clientId, status])
  @@index([groupId, status])
  @@index([officeId, status])
  @@index([productId, status])
  @@index([submittedById, status])
  @@index([loanOfficerId, status])
  @@index([fundId, status])
}

model LoanApplicationDocument {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @db.Uuid
  uploadedById  String?
  name          String
  description   String?
  objectKey     String          @unique
  sha256        String
  mediaType     String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy    User?           @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

model LoanApplicationNote {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @db.Uuid
  authorId      String
  body          String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User            @relation(fields: [authorId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

model PermissionDefinition {
  code             String                      @id
  description      String
  riskLevel        String
  groupPermissions PermissionGroupPermission[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
}

model PermissionGroup {
  id             String                      @id @default(uuid()) @db.Uuid
  organizationId String                      @db.Uuid
  name           String
  description    String?
  system         Boolean                     @default(false)
  organization   Organization                @relation(fields: [organizationId], references: [id])
  permissions    PermissionGroupPermission[]
  assignments    UserPermissionAssignment[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PermissionGroupPermission {
  groupId        String               @db.Uuid
  permissionCode String
  group          PermissionGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission     PermissionDefinition @relation(fields: [permissionCode], references: [code], onDelete: Restrict)
  createdAt      DateTime             @default(now())

  @@id([groupId, permissionCode])
  @@index([permissionCode])
}

model UserPermissionAssignment {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String
  groupId              String          @db.Uuid
  scope                PermissionScope
  officeId             String?         @db.Uuid
  includeChildOffices  Boolean         @default(false)
  approvalLimitMinor   BigInt?
  approvalCurrencyCode String?
  validFrom            DateTime        @default(now())
  validUntil           DateTime?
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group                PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  office               Office?         @relation(fields: [officeId], references: [id])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([userId, groupId, scope, officeId])
  @@index([userId, validUntil])
  @@index([officeId, scope])
}

model Approval {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @db.Uuid
  reviewerId    String
  decision      String
  reason        String?
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  reviewer      User            @relation(fields: [reviewerId], references: [id])
  decidedAt     DateTime        @default(now())

  @@index([applicationId, decidedAt])
}

model Loan {
  id                       String               @id @default(uuid()) @db.Uuid
  applicationId            String               @unique @db.Uuid
  clientId                 String?              @db.Uuid
  groupId                  String?              @db.Uuid
  productId                String               @db.Uuid
  officeId                 String               @db.Uuid
  loanOfficerId            String?
  fundId                   String?              @db.Uuid
  accountNumber            String               @unique
  denominationCurrency     String               @default("UGX")
  principalMinor           BigInt
  termsSnapshot            Json?
  scheduleVersion          Int                  @default(1)
  status                   LoanStatus           @default(APPROVED)
  disbursedOn              DateTime?            @db.Date
  maturesOn                DateTime?            @db.Date
  // Set only when a loan is written off (mirrors Fineract's loan-level write-off summary,
  // since a write-off closes out remaining balance at the loan level rather than being
  // allocated back onto individual installment rows). Always 0 for non-written-off loans.
  principalWrittenOffMinor BigInt               @default(0)
  interestWrittenOffMinor  BigInt               @default(0)
  feesWrittenOffMinor      BigInt               @default(0)
  penaltiesWrittenOffMinor BigInt               @default(0)
  writtenOffOn             DateTime?            @db.Date
  writtenOffByName         String?
  // Set at disbursement time when the operator checked "pay off previous loan" (see
  // disburse-loan.ts): identifies the client's earlier loan this disbursement paid down before
  // handing the remainder to the client. Informational/audit only -- the actual money movement
  // is a separate transferSavingsToLoan() repayment transaction against topUpOfLoan, not
  // anything this field drives directly.
  topUpOfLoanId            String?              @db.Uuid
  application              LoanApplication      @relation(fields: [applicationId], references: [id])
  client                   Client?              @relation(fields: [clientId], references: [id])
  group                    Group?               @relation(fields: [groupId], references: [id])
  product                  LoanProduct          @relation(fields: [productId], references: [id])
  office                   Office               @relation(fields: [officeId], references: [id])
  fund                     Fund?                @relation(fields: [fundId], references: [id])
  loanOfficer              User?                @relation("AssignedLoanOfficer", fields: [loanOfficerId], references: [id])
  topUpOfLoan              Loan?                @relation("LoanTopUpChain", fields: [topUpOfLoanId], references: [id])
  topUpLoans               Loan[]               @relation("LoanTopUpChain")
  installments             LoanInstallment[]
  transactions             LoanTransaction[]
  charges                  Charge[]
  documents                Document[]
  notes                    LoanNote[]
  collateralItems          LoanCollateral[]
  guarantors               Guarantor[]
  reminders                Reminder[]
  serviceRequests          LoanServiceRequest[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([officeId, status])
  @@index([clientId, status])
  @@index([groupId, status])
  @@index([topUpOfLoanId])
  @@index([fundId, status])
}

model LoanInstallment {
  id                       String                      @id @default(uuid()) @db.Uuid
  loanId                   String                      @db.Uuid
  installmentNumber        Int
  dueOn                    DateTime                    @db.Date
  principalDueMinor        BigInt
  interestDueMinor         BigInt
  feesDueMinor             BigInt                      @default(0)
  penaltiesDueMinor        BigInt                      @default(0)
  // Monitoring fee is tracked separately from feesDueMinor/feesPaidMinor going forward (see
  // repayment-schedule.ts / repayment-allocation.ts) so it never shares an income account or
  // schedule line with interest or generic fees, even when their rates coincide. Always 0 on
  // installments generated before this field existed -- their feesDueMinor historically included
  // the monitoring-fee amount and is left untouched.
  monitoringFeeDueMinor    BigInt                      @default(0)
  principalPaidMinor       BigInt                      @default(0)
  interestPaidMinor        BigInt                      @default(0)
  feesPaidMinor            BigInt                      @default(0)
  penaltiesPaidMinor       BigInt                      @default(0)
  monitoringFeePaidMinor   BigInt                      @default(0)
  principalWaivedMinor     BigInt                      @default(0)
  interestWaivedMinor      BigInt                      @default(0)
  feesWaivedMinor          BigInt                      @default(0)
  penaltiesWaivedMinor     BigInt                      @default(0)
  monitoringFeeWaivedMinor BigInt                      @default(0)
  // Set the first (and, in the current one-time-only assessment model, only) time
  // assess-loan-penalties.ts posts an accrual journal for this installment. Null forever for
  // installments this job has not assessed -- including all historical installments, since the
  // job's bounded assessment window structurally cannot reach into the past. Used to route this
  // installment's penalty collection to the penalty receivable account (not penalty income again)
  // at repayment time, so accrual-assessed penalty income is never double-counted.
  penaltyAssessedOn        DateTime?                   @db.Date
  // Set the first (and, in the current one-time-only accrual model, only) time
  // assess-loan-interest-accruals.ts posts an accrual journal recognizing this installment's
  // interest as earned income before it has been collected in cash. Null forever for
  // installments this job has not accrued -- including all historical installments, since the
  // job's bounded assessment window structurally cannot reach into the past. Used to route this
  // installment's interest collection to the interest receivable account (not interest income
  // again) at repayment time, so accrual-recognized interest income is never double-counted --
  // mirrors penaltyAssessedOn exactly, one field per accrual-eligible revenue line.
  interestAccruedOn        DateTime?                   @db.Date
  loan                     Loan                        @relation(fields: [loanId], references: [id])
  reminders                Reminder[]
  transactionAllocations   LoanTransactionAllocation[]
  createdAt                DateTime                    @default(now())

  @@unique([loanId, installmentNumber])
  @@index([dueOn])
}

model LoanTransaction {
  id                      String                      @id @default(uuid()) @db.Uuid
  loanId                  String                      @db.Uuid
  transactionType         String
  businessDate            DateTime                    @db.Date
  settlementCurrency      String
  settlementChannel       String
  settlementAccountId     String?                     @db.Uuid
  settlementAmountMinor   BigInt
  denominationAmountMinor BigInt
  priceSnapshotId         String?                     @db.Uuid
  externalReference       String?
  idempotencyKey          String                      @unique
  reversedById            String?                     @unique @db.Uuid
  recordedByUserId        String?
  loan                    Loan                        @relation(fields: [loanId], references: [id])
  settlementAccount       SettlementAccount?          @relation(fields: [settlementAccountId], references: [id])
  priceSnapshot           PriceSnapshot?              @relation(fields: [priceSnapshotId], references: [id])
  reversedBy              LoanTransaction?            @relation("TransactionReversal", fields: [reversedById], references: [id])
  reverses                LoanTransaction?            @relation("TransactionReversal")
  recordedBy              User?                       @relation("RecordedLoanTransactions", fields: [recordedByUserId], references: [id])
  allocations             LoanTransactionAllocation[]
  serviceRequest          LoanServiceRequest?
  createdAt               DateTime                    @default(now())

  @@index([loanId, businessDate])
  @@index([externalReference])
  @@index([settlementAccountId])
  @@index([recordedByUserId])
}

model LoanTransactionAllocation {
  id                 String          @id @default(uuid()) @db.Uuid
  transactionId      String          @db.Uuid
  installmentId      String          @db.Uuid
  principalMinor     BigInt          @default(0)
  interestMinor      BigInt          @default(0)
  feesMinor          BigInt          @default(0)
  penaltiesMinor     BigInt          @default(0)
  // Separate from feesMinor going forward so the repayment allocation audit trail matches the
  // installment's own monitoringFeeDueMinor/monitoringFeePaidMinor split (see Problem 2). Always
  // 0 on historical allocation rows, which recorded monitoring fee collections under feesMinor.
  monitoringFeeMinor BigInt          @default(0)
  transaction        LoanTransaction @relation(fields: [transactionId], references: [id])
  installment        LoanInstallment @relation(fields: [installmentId], references: [id])
  createdAt          DateTime        @default(now())

  @@unique([transactionId, installmentId])
  @@index([installmentId])
}

model LoanCollateral {

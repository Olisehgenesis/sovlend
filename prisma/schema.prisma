model SavingsAccount {
  id             String               @id @default(uuid()) @db.Uuid
  clientId       String?              @db.Uuid
  groupId        String?              @db.Uuid
  productId      String?              @db.Uuid
  fieldOfficerId String?
  submittedById  String?
  approvedById   String?
  accountNumber  String               @unique
  accountType    String               @default("SAVINGS")
  externalId     String?
  currencyCode   String
  status         String
  submittedOn    DateTime?            @db.Date
  approvedOn     DateTime?            @db.Date
  termsSnapshot  Json?
  // The savings account the standing-order sweep pulls from when a loan installment for this
  // client comes due; at most one account per client should carry this flag (enforced in
  // application code, not a DB constraint, since Prisma has no partial-unique-index support here).
  isDefault      Boolean              @default(false)
  client         Client?              @relation(fields: [clientId], references: [id])
  group          Group?               @relation(fields: [groupId], references: [id])
  product        SavingsProduct?      @relation(fields: [productId], references: [id])
  fieldOfficer   User?                @relation("AssignedSavingsOfficer", fields: [fieldOfficerId], references: [id])
  submittedBy    User?                @relation("SavingsAccountSubmittedBy", fields: [submittedById], references: [id])
  approvedBy     User?                @relation("SavingsAccountApprovedBy", fields: [approvedById], references: [id])
  transactions   SavingsTransaction[]
  charges        Charge[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([clientId, status])
  @@index([groupId, status])
  @@index([productId])
}

model SavingsTransaction {

  payoutAddress String?
  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accesses      InvestorOrganizationAccess[]
  commitments   InvestmentCommitment[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
}

model InvestorOrganizationAccess {
  id             String                 @id @default(uuid()) @db.Uuid
  investorId     String                 @db.Uuid
  organizationId String                 @db.Uuid
  status         InvestorAccessStatus   @default(REQUESTED)
  approvedAt     DateTime?
  investor       InvestorProfile        @relation(fields: [investorId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commitments    InvestmentCommitment[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([investorId, organizationId])
  @@index([organizationId, status])
}

model InvestorInvite {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  email          String
  tokenHash      String               @unique
  status         InvestorAccessStatus @default(INVITED)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())

  @@index([email, status])
  @@index([organizationId, status])
}

model InvestorAccessRequest {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String
  email          String
  message        String?
  status         InvestorAccessStatus @default(REQUESTED)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([email])
